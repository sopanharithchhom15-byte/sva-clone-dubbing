      "start": "00:00:49,000",
      "end": "00:00:50,000",
      "start_sec": 49.0,
      "end_sec": 50.0,
      "text": "ខ្ញុំ... ខ្ញុំមិនដឹងទេ![cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 8,
      "start": "00:00:50,200",
      "end": "00:00:52,000",
      "start_sec": 50.2,
      "end_sec": 52.0,
      "text": "ទៅពិនិត្យមើលកាមេរ៉ាសុវត្ថិភាពឱ្យអញភ្លាម![cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 9,
      "start": "00:00:52,500",
      "end": "00:00:55,800",
      "start_sec": 52.5,
      "end_sec": 55.8,
      "text": "វ៉ៃអើយ... ក្នុងបន្ទប់គ្មានកាមេរ៉ាទេ តែតាមផ្លូវដើរមាន! ច្បាស់ជាតាមរកដល់ក្បាលអញមិនខាន![cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 10,
      "start": "00:00:56,000",
      "end": "00:00:58,000",
      "start_sec": 56.0,
      "end_sec": 58.0,
      "text": "លោកយាយថ្លៃ! លងខ្មោចហើយ![cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 11,
      "start": "00:00:58,500",
      "end": "00:01:00,800",
      "start_sec": 58.5,
      "end_sec": 60.8,
      "text": "អាអៀនតូច! ហ៊ានចូលមកក្នុងបន្ទប់សម្រាករបស់យើងផងហ្ហេស?[cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 12,
      "start": "00:01:01,000",
      "end": "00:01:05,000",
      "start_sec": 61.0,
      "end_sec": 65.0,
      "text": "ក្រពះលោកយាយ... និយាយទៅលោកយាយក៏មិនយល់ដែរ! លោកនាយកថាត្រូវប្តូរលោកយាយទៅឡើងលើ楼...[cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 13,
      "start": "00:01:08,000",
      "end": "00:01:11,500",
      "start_sec": 68.0,
      "end_sec": 71.5,
      "text": "លឺថាក្នុងកាមេរ៉ាសុវត្ថិភាពមើលមិនឃើញមនុស្សទេ តែក្នុងបន្ទប់គេបែរជាមានឆ្អឹងលេចចេញមក ច្បាស់ជាលងខ្មោចហើយ![cite: 6]",
      "voice": "hero_male",
      "has_audio": true
    },
    {
      "index": 14,
      "start": "00:01:11,600",
      "end": "00:01:12,800",
      "start_sec": 71.6,
      "end_sec": 72.8,
      "text": "ឬមួយជាអ្នកគ្រូពេទ្យដែលមើលថែគេជាអ្នកឱ្យ?[cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 15,
      "start": "00:01:13,000",
      "end": "00:01:15,000",
      "start_sec": 73.0,
      "end_sec": 75.0,
      "text": "នាងមិនឃើញអ្នកគ្រូពេទ្យភ័យស្លន់ស្លោថ្នាក់ហ្នឹងទេហ្ហេស? នាងសុំឈប់ធ្វើការយូរហើយ តើអាចជាប្រគល់ឱ្យបានយ៉ាងម៉េច?[cite: 6]",
      "voice": "hero_male",
      "has_audio": true
    },
    {
      "index": 16,
      "start": "00:01:15,500",
      "end": "00:01:19,000",
      "start_sec": 75.5,
      "end_sec": 79.0,
      "text": "កាមេរ៉ាសុវត្ថិភាពថតមិនទាន់អញទេ! អញនៅតែជាមនុស្សឆ្កួតដែលគ្មានកង្វល់ដដែល![cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 17,
      "start": "00:01:21,000",
      "end": "00:01:24,800",
      "start_sec": 81.0,
      "end_sec": 84.8,
      "text": "ក្មេងៗត្រូវតែគោរពចាស់ទុំ! កាលពីម្សិលមិញលោកពូឱ្យឯងភ្លៅមាន់ពីរ ថ្ងៃនេះឯងត្រូវតែសងមកវិញ![cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 18,
      "start": "00:01:25,000",
      "end": "00:01:26,500",
      "start_sec": 85.0,
      "end_sec": 86.5,
      "text": "លោកពូ! ឱ្យលោកពូហូបចុះ![cite: 6]",
      "voice": "hero_male",
      "has_audio": true
    },
    {
      "index": 19,
      "start": "00:01:27,000",
      "end": "00:01:30,500",
      "start_sec": 87.0,
      "end_sec": 90.5,
      "text": "ក្មួយប្រុសធំ! លោកពូស្រឡាញ់ឯងណាស់! ស្អែកនេះយើងនឹងប្រគល់រាជបល្ល័ង្កឱ្យឯង![cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 20,
      "start": "00:01:31,000",
      "end": "00:01:34,000",
      "start_sec": 91.0,
      "end_sec": 94.0,
      "text": "ច្របូកច្របល់អស់ហើយ! ស្រាក្រហមឡាហ្វីឆ្នាំ ១៩៨២ របស់អញនៅឯណា? អ្នកណាលួចស្រារបស់អញ?![cite: 6]",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
