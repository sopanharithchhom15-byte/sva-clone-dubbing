      "start": "00:02:07,000",
      "end": "00:02:08,000",
      "start_sec": 127.0,
      "end_sec": 128.0,
      "text": "ចុះបន្តិចទៀតពួកយើងចេញទៅលេងខាងក្រៅអត់?[cite: 6]",
      "voice": "hero_male",
      "has_audio": true
    },
    {
      "index": 29,
      "start": "00:02:08,200",
      "end": "00:02:14,500",
      "start_sec": 128.2,
      "end_sec": 134.5,
      "text": "យើងជាក្សត្រមួយអង្គ ត្រូវលីរែករាជកិច្ចដ៏ធំធេងរបស់ប្រទេសជាតិ! មិនអាចទៅលេងជាមួយពួកឯងបានទេ![cite: 6]",
      "voice": "heroine_female",
