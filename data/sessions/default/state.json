    },
    {
      "index": 30,
      "start": "00:02:16,500",
      "end": "00:02:19,500",
      "start_sec": 136.5,
      "end_sec": 139.5,
      "text": "លោកពូស្អប់ខ្ញុំហើយមែនទេ? ខ្ញុំចាកចេញទៅឥឡូវនេះហើយ...[cite: 6]",
      "voice": "hero_male",
