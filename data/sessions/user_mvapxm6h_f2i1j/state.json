    {
      "index": 8,
      "start": "00:00:36,000",
      "end": "00:00:38,800",
      "start_sec": 36,
      "end_sec": 38.8,
      "text": "មិននឹកស្មានថាមនុស្សស្រីឆ្កួតម្នាក់នេះ មានឥទ្ធិពលលើពួកអ្នកជំងឺផ្លូវចិត្តទាំងនេះសោះ!",
      "voice": "hero_male",
      "has_audio": true
    },
    {
      "index": 9,
      "start": "00:00:39,000",
      "end": "00:00:42,800",
      "start_sec": 39,
      "end_sec": 42.8,
      "text": "លោកយាយថ្លៃ កុំបញ្ជាទៀតអី! ប្រញាប់ប្រាប់ពួកគាត់ឱ្យឈប់ទៅ ខ្ញុំនឹងថែមនំខេកស្ត្រប៊ែរីឱ្យពីរដុំ!",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 10,
      "start": "00:00:43,000",
      "end": "00:00:46,000",
      "start_sec": 43,
      "end_sec": 46,
