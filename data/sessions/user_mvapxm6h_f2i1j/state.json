    {
      "index": 4,
      "start": "00:00:20,000",
      "end": "00:00:24,800",
      "start_sec": 20,
      "end_sec": 24.8,
      "text": "ស្អីគេ? ពិភពលោកនេះជារបស់យើង! តើមានអ្នកណាដែលយើងប្រមាថមិនបានទៅ?!",
      "voice": "heroine_female",
      "has_audio": true
