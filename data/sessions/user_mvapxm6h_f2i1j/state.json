      "start": "00:00:25,000",
      "end": "00:00:26,000",
      "start_sec": 25,
      "end_sec": 26,
      "text": "ចេញទៅ!",
      "voice": "hero_male",
      "has_audio": true
    },
    {
      "index": 6,
      "start": "00:00:26,100",
      "end": "00:00:30,800",
      "start_sec": 26.1,
      "end_sec": 30.8,
      "text": "ស្អី គេ?! ហ៊ានដេញយើងចេញផងហ្ហេស? មើលទៅឯងមិនទាន់ឃើញក្តាមឈូស មិនទាន់ស្រក់ទឹកភ្នែកទេតើ!",
      "voice": "heroine_female",
      "has_audio": true
