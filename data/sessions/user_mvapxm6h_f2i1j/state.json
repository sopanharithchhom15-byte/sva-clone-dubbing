    {
      "index": 3,
      "start": "00:00:16,000",
      "end": "00:00:19,800",
      "start_sec": 16,
      "end_sec": 19.8,
      "text": "លោកយាយថ្លៃ! កុំអីណា លោកម្នាក់នេះពួកយើងប្រមាថមិនបានទេណា!",
      "voice": "heroine_female",
      "has_audio": true
