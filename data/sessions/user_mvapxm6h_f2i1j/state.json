      "start": "00:00:31,000",
      "end": "00:00:33,800",
      "start_sec": 31,
      "end_sec": 33.8,
      "text": "ឱ្យឯងស្គាល់ឫទ្ធានុភាពរបស់យើងបន្តិច! នាយ កង! ចាប់វាឱ្យជាប់!",
      "voice": "heroine_female",
      "has_audio": false
