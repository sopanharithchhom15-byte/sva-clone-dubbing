      "start_sec": 5,
      "end_sec": 8,
      "text": "នែ៎! ឯងជាអ្នកណា? ម៉េចក៏មកអង្គុយតែម្នាក់ឯងនៅទីនេះអញ្ចឹង?",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 1,
      "start": "00:00:11,000",
      "end": "00:00:12,800",
      "start_sec": 11,
      "end_sec": 12.8,
      "text": "នែ៎! យើងកំពុងសួរឯងណា!",
      "voice": "heroine_female",
      "has_audio": true
    },
    {
      "index": 2,
      "start": "00:00:13,000",
      "end": "00:00:15,800",
      "start_sec": 13,
      "end_sec": 15.8,
      "text": "នាយ កង! ចាប់អាម្នាក់ហ្នឹងយកទៅកាត់ក្បាលចោលភ្លាម!",
      "voice": "old_man",
